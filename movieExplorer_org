// CONTROLS
function sortBy(type) {
    let endpoint = '';
    if(type === 'popularity') endpoint = `${API_URL}/movie/popular?api_key=${API_KEY}`;
    else if(type === 'rating') endpoint = `${API_URL}/movie/top_rated?api_key=${API_KEY}`;
    else if(type === 'release') endpoint = `${API_URL}/movie/now_playing?api_key=${API_KEY}`;
    
    fetch(endpoint)
        .then(r => r.json())
        .then(data => displaySearchResults(data.results))
        .catch(handleError);
}

function filterType(type) {
    let endpoint = '';
    if(type === 'movie') endpoint = `${API_URL}/movie/popular?api_key=${API_KEY}`;
    else if(type === 'tv') endpoint = `${API_URL}/tv/popular?api_key=${API_KEY}`;
    else {
        document.getElementById('searchResults').style.display = 'none';
        document.getElementById('homeView').style.display = 'block';
        return;
    }
    
    fetch(endpoint)
        .then(r => r.json())
        .then(data => displaySearchResults(data.results))
        .catch(handleError);
}

