                         alt="${f.title}" 
                         onclick="openMovie(${f.id}, 'movie')" />
                    <div class="rec-meta">
                        <h4>${f.title}</h4>
                        <p>★ ${f.rating ? f.rating.toFixed(1) : 'N/A'}</p>
                        <button class="btn-remove" onclick="addFav(${f.id})">Remove</button>
                    </div>
                </div>
            `).join('')}
        </div>
        ${renderRecommendations(recommendations)}
    `;
}

// WATCH LATER - Modified to sync with Firestore
function getWatchLater() {
    return JSON.parse(localStorage.getItem('watchLater') || '[]');
}

function isWatch(id) {
    return getWatchLater().some(w => w.id === id);
}

async function addWatch(id, title = '', poster = '', rating = 0, release = '') {
    let watch = getWatchLater();
    const exists = watch.findIndex(w => w.id === id);
    
    if(exists >= 0) {
        watch.splice(exists, 1);
    } else {
        watch.push({ id, title, poster, rating, release });
    }
    
    localStorage.setItem('watchLater', JSON.stringify(watch));
    
    // Sync to Firestore
    await syncToFirestore();
    
    if(currentTab === 'watchLater') loadWatchLater();
}

async function loadWatchLater() {
    const watch = getWatchLater();
    const container = document.getElementById('watchLaterContent');
    
    // Fetch recommendations
    const recommendations = await fetchRecommendations();
    
    if(watch.length === 0) {
        container.innerHTML = `
            <div class="empty-fav-msg">
                <i class="fas fa-clock" style="font-size: 4rem; color: var(--accent); margin-bottom: 20px;"></i>
                <h3>No items to watch later</h3>
                <p style="color: var(--text-secondary); margin: 10px 0 20px;">Save content you want to watch later</p>
                <button class="modal-btn modal-btn-primary" onclick="switchTab('home')">Browse Content</button>
            </div>
            ${renderRecommendations(recommendations)}
        `;
        return;
    }
    
    container.innerHTML = `
        <div class="rec-gallery">
            ${watch.map(w => `
                <div class="rec-item">
                    <img src="${w.poster ? IMG_BASE + w.poster : 'https://via.placeholder.com/200x300?text=No+Image'}" 
                         alt="${w.title}" 
                         onclick="openMovie(${w.id}, 'movie')" />
                    <div class="rec-meta">
                        <h4>${w.title}</h4>
                        <p>★ ${w.rating ? w.rating.toFixed(1) : 'N/A'}</p>
                        <button class="btn-remove" onclick="addWatch(${w.id})">Remove</button>
                    </div>
                </div>
            `).join('')}
        </div>
        ${renderRecommendations(recommendations)}
    `;
}

// MODAL
async function openMovie(id, type = 'movie') {
    try {
        showLoader();
        const endpoint = type === 'tv' ? `${API_URL}/tv/${id}` : `${API_URL}/movie/${id}`;
        const [details, credits, videos] = await Promise.all([
            fetch(`${endpoint}?api_key=${API_KEY}`).then(r => r.json()),
            fetch(`${endpoint}/credits?api_key=${API_KEY}`).then(r => r.json()),
            fetch(`${endpoint}/videos?api_key=${API_KEY}`).then(r => r.json())
        ]);
        
        currentModalMovie = details;
        currentTrailerKey = videos.results.find(v => v.type === 'Trailer')?.key || null;
        
        document.getElementById('modalHeader').style.backgroundImage = 
            `url('${IMG_ORIGINAL}${details.backdrop_path || details.poster_path}')`;
        document.getElementById('modalTitle').innerText = details.title || details.name || 'Unknown';
        document.getElementById('modalOverview').innerText = details.overview || 'No description available';
        document.getElementById('modalRelease').innerText = details.release_date || details.first_air_date || 'N/A';
        document.getElementById('modalRating').innerText = `★ ${(details.vote_average || 0).toFixed(1)}/10`;
        document.getElementById('modalRuntime').innerText = details.runtime ? `${details.runtime} min` : (details.episode_run_time?.[0] ? `${details.episode_run_time[0]} min` : 'N/A');
        document.getElementById('modalGenres').innerText = details.genres?.map(g => g.name).join(', ') || 'N/A';
        
        const tags = [];
        if(details.vote_average >= 7) tags.push('<span class="modal-tag">Highly Rated</span>');
        if(details.adult) tags.push('<span class="modal-tag">18+</span>');
        tags.push(`<span class="modal-tag">${type === 'tv' ? 'TV Show' : 'Movie'}</span>`);
        document.getElementById('modalTags').innerHTML = tags.join('');
        
        if(credits.cast && credits.cast.length > 0) {
            const castHTML = credits.cast.slice(0, 8).map(c => `
                <div class="cast-item">
                    <img src="${c.profile_path ? IMG_BASE + c.profile_path : 'https://via.placeholder.com/120x160?text=No+Image'}" 
                         alt="${c.name}" />
                    <p><strong>${c.name}</strong></p>
                    <p class="character">${c.character || 'N/A'}</p>
                </div>
            `).join('');
            document.getElementById('modalCast').innerHTML = castHTML;
            document.getElementById('modalCastSection').style.display = 'block';
        } else {
            document.getElementById('modalCastSection').style.display = 'none';
        }
        
        updateModalFavBtn();
        updateModalWatchBtn();
        
        document.getElementById('movieModal').style.display = 'flex';
        hideLoader();
    } catch(err) {
        handleError(err);
    }
}

function closeModal() {
    document.getElementById('movieModal').style.display = 'none';
    currentModalMovie = null;
    currentTrailerKey = null;
}

function updateModalFavBtn() {
    const btn = document.getElementById("modalFavBtn");
    if(!currentModalMovie) return;
    const fav = isFav(currentModalMovie.id);
    btn.innerHTML = fav ? '<i class="fas fa-check"></i> In List' : '<i class="fas fa-heart"></i> Add';
    btn.style.background = fav ? 'rgba(0,0,0,0.6)' : 'rgba(255,255,255,0.06)';
}

function updateModalWatchBtn() {
    const btn = document.getElementById("modalWatchBtn");
    if(!currentModalMovie) return;
    const watch = isWatch(currentModalMovie.id);
    btn.innerHTML = watch ? '<i class="fas fa-check"></i> Added' : '<i class="fas fa-clock"></i> Watch Later';
    btn.style.background = watch ? 'rgba(0,0,0,0.6)' : 'rgba(255,255,255,0.06)';
}

function toggleModalFav() {
    if(!currentModalMovie) return;
    const mv = currentModalMovie;
    if(isFav(mv.id)) {
        addFav(mv.id);
    } else {
        addFav(mv.id, mv.title || mv.name || '', mv.poster_path || '', mv.vote_average || 0, mv.release_date || '');
    }
    updateModalFavBtn();
}

function toggleModalWatch() {
    if(!currentModalMovie) return;
    const mv = currentModalMovie;
    if(isWatch(mv.id)) {
        addWatch(mv.id);
    } else {
        addWatch(mv.id, mv.title || mv.name || '', mv.poster_path || '', mv.vote_average || 0, mv.release_date || '');
    }
    updateModalWatchBtn();
}

async function playTrailer() {
    try {
        if(!currentModalMovie) return;
        if(!currentTrailerKey) {
            const q = encodeURIComponent((currentModalMovie.title || currentModalMovie.name || '') + ' trailer');
            window.open(`https://www.youtube.com/results?search_query=${q}`, '_blank');
            return;
        }
        try {
            await loadYouTubeAPIIfNeeded();
        } catch(apiErr) {
            console.warn("YT API load failed, fallback to watch page", apiErr);
            window.open(`https://www.youtube.com/watch?v=${currentTrailerKey}`, '_blank');
            return;
        }
        if(ytApiReady) {
            _createYTPlayerAndPlay(currentTrailerKey);
            document.getElementById("trailerOverlay").style.display = "block";
        } else {
            pendingPlayKey = currentTrailerKey;
            document.getElementById("trailerOverlay").style.display = "block";
        }
    } catch(err) {
        console.error("playTrailer error", err);
        window.open(`https://www.youtube.com/watch?v=${currentTrailerKey}`, '_blank');
    }
}

function closeTrailer(e) {
    try {
        const overlay = document.getElementById("trailerOverlay");
        if(overlay) overlay.style.display = "none";
        if(ytPlayer) {
            try { ytPlayer.stopVideo(); } catch(e) {}
            try { ytPlayer.destroy(); } catch(e) {}
            ytPlayer = null;
        }
        const container = document.getElementById("ytPlayerContainer");
        if(container) container.innerHTML = '';
        pendingPlayKey = null;
    } catch(err) {
        console.warn("closeTrailer cleanup error", err);
    }
}

window.onYouTubeIframeAPIReady = function() {
    onYouTubeIframeAPIReady();
};

(function preinjectYT(){
    if(window.YT && window.YT.Player) {
        ytApiReady = true;
        return;
    }
    if(document.querySelector('script[src="https://www.youtube.com/iframe_api"]')) return;
    const tag = document.createElement('script');
    tag.src = "https://www.youtube.com/iframe_api";
    tag.async = true;
    document.head.appendChild(tag);
})();

function shareMovie() {
    if(!currentModalMovie) return;
    const movieId = currentModalMovie.id;
    const movieTitle = currentModalMovie.title || currentModalMovie.name || 'Unknown';
    const shareUrl = `${window.location.origin}${window.location.pathname}?movie=${movieId}`;
    document.getElementById('shareLink').innerText = shareUrl;
    document.getElementById('shareModal').style.display = 'flex';
}

function closeShareModal() {
    document.getElementById('shareModal').style.display = 'none';
}

function copyShareLink() {
    const link = document.getElementById('shareLink').innerText;
    navigator.clipboard.writeText(link).then(() => {
        alert('Link copied to clipboard!');
    }).catch(err => {
        console.error('Failed to copy:', err);
        alert('Failed to copy link');
    });
}

window.addEventListener('load', () => {
    const urlParams = new URLSearchParams(window.location.search);
    const movieId = urlParams.get('movie');
    if(movieId && !isNaN(movieId)) {
        setTimeout(() => {
            openMovie(parseInt(movieId));
        }, 1000);
    }
});

// UTILITY
function showLoader() {
    document.getElementById('loader').style.display = 'block';
    document.getElementById('loadingOverlay').style.display = 'block';
}

function hideLoader() {
    document.getElementById('loader').style.display = 'none';
    document.getElementById('loadingOverlay').style.display = 'none';
}

function handleError(err) {
    console.error('Error:', err);
    hideLoader();
    document.getElementById('errorText').innerText = err.message || 'Something went wrong';
    document.getElementById('errorMsg').style.display = 'block';
}

function loadYouTubeAPIIfNeeded() {
    return new Promise((resolve, reject) => {
        if(ytApiReady) {
            resolve();
            return;
        }
        const checkInterval = setInterval(() => {
            if(ytApiReady) {
                clearInterval(checkInterval);
                resolve();
            }
        }, 100);
        setTimeout(() => {
            clearInterval(checkInterval);
            if(!ytApiReady) reject(new Error('YT API timeout'));
            else resolve();
        }, 5000);
    });
}

function onYouTubeIframeAPIReady() {
    ytApiReady = true;
    if(pendingPlayKey) {
        _createYTPlayerAndPlay(pendingPlayKey);
        pendingPlayKey = null;
    }
}

function _createYTPlayerAndPlay(videoKey) {
    const container = document.getElementById('ytPlayerContainer');
    container.innerHTML = '<div id="ytPlayer"></div>';
    ytPlayer = new YT.Player('ytPlayer', {
        width: '100%',
        height: '500',
        videoId: videoKey,
        playerVars: { autoplay: 1, modestbranding: 1, rel: 0 },
        events: {
            onReady: (e) => e.target.playVideo(),
            onError: (e) => {
                console.error('YT Player error:', e);
                window.open(`https://www.youtube.com/watch?v=${videoKey}`, '_blank');
                closeTrailer();
            }
        }
    });
}
