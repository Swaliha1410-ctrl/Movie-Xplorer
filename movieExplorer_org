let currentUserEmail = null;
let firestoreUnsubscribe = null;

// Sync user data to Firestore
async function syncToFirestore() {
    if (!window.firebaseInitialized || !currentUserEmail) return;
    
    try {
        const userDocRef = window.firestoreDoc(window.firestoreDB, 'users', currentUserEmail);
        const userData = {
            email: currentUserEmail,
            name: localStorage.getItem('userName') || '',
            favorites: JSON.parse(localStorage.getItem('favorites') || '[]'),
            watchLater: JSON.parse(localStorage.getItem('watchLater') || '[]'),
            lastUpdated: new Date().toISOString()
        };
        
        await window.firestoreSetDoc(userDocRef, userData, { merge: true });
        console.log('Data synced to Firestore');
    } catch (error) {
        console.error('Error syncing to Firestore:', error);
    }
}

// Load user data from Firestore
async function loadFromFirestore(email) {
    if (!window.firebaseInitialized || !email) return;
    
    try {
        const userDocRef = window.firestoreDoc(window.firestoreDB, 'users', email);
        const docSnap = await window.firestoreGetDoc(userDocRef);
        
        if (docSnap.exists()) {
            const data = docSnap.data();
            console.log('Loaded data from Firestore:', data);
            
            // Update localStorage with Firestore data
            if (data.favorites) {
                localStorage.setItem('favorites', JSON.stringify(data.favorites));
            }
            if (data.watchLater) {
                localStorage.setItem('watchLater', JSON.stringify(data.watchLater));
            }
            if (data.name) {
                localStorage.setItem('userName', data.name);
            }
            
            return data;
        } else {
            console.log('No Firestore data found for user');
            // Create initial document
            await syncToFirestore();
        }
    } catch (error) {
        console.error('Error loading from Firestore:', error);
    }
}

// Setup real-time listener for user data
function setupFirestoreListener(email) {
    if (!window.firebaseInitialized || !email) return;
    
    // Unsubscribe from previous listener if exists
    if (firestoreUnsubscribe) {
        firestoreUnsubscribe();
    }
    
    try {
        const userDocRef = window.firestoreDoc(window.firestoreDB, 'users', email);
        
        firestoreUnsubscribe = window.firestoreOnSnapshot(userDocRef, (doc) => {
            if (doc.exists()) {
                const data = doc.data();
                console.log('Firestore real-time update received:', data);
                
                // Update localStorage with real-time changes
                if (data.favorites) {
                    localStorage.setItem('favorites', JSON.stringify(data.favorites));
                    // Refresh favorites view if currently viewing
                    if (document.getElementById('favoritesView').style.display !== 'none') {
                        loadFavorites();
                    }
                }
                if (data.watchLater) {
                    localStorage.setItem('watchLater', JSON.stringify(data.watchLater));
                    // Refresh watch later view if currently viewing
                    if (document.getElementById('watchLaterView').style.display !== 'none') {
                        loadWatchLater();
                    }
                }
            }
        }, (error) => {
            console.error('Firestore listener error:', error);
        });
    } catch (error) {
        console.error('Error setting up Firestore listener:', error);
    }
}

// Cleanup Firestore listener
function cleanupFirestoreListener() {
    if (firestoreUnsubscribe) {
        firestoreUnsubscribe();
        firestoreUnsubscribe = null;
    }
}

