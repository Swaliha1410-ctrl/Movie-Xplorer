// GENRES
let allGenres = {};
async function loadGenres() {
    try {
        const [movieRes, tvRes] = await Promise.all([
            fetch(`${API_URL}/genre/movie/list?api_key=${API_KEY}`),
            fetch(`${API_URL}/genre/tv/list?api_key=${API_KEY}`)
        ]);
        const movieData = await movieRes.json();
        const tvData = await tvRes.json();
        
        movieData.genres.forEach(g => allGenres[g.id] = g.name);
        tvData.genres.forEach(g => allGenres[g.id] = g.name);
        
        const uniqueGenres = [...new Set(Object.values(allGenres))];
        const genreOptions = uniqueGenres.map(name => 
            `<option value="${name}">${name}</option>`
        ).join('');
        
        const selectElement = document.getElementById('genreSelect');
        selectElement.innerHTML = '<option value="">All Genres</option>' + genreOptions;
    } catch(err) {
        console.error('Error loading genres:', err);
    }
}

function filterByGenre(genreName) {
    if (!genreName) {
        // Reset to home view when "All Genres" is selected
        switchTab('home');
        return;
    }
    
    const genreId = Object.keys(allGenres).find(key => allGenres[key] === genreName);
    if(genreId) {
        loadMoviesByGenre(genreId);
    }
}

async function loadMoviesByGenre(genreId) {
    try {
        showLoader();
        const res = await fetch(`${API_URL}/discover/movie?api_key=${API_KEY}&with_genres=${genreId}&sort_by=popularity.desc`);
        const data = await res.json();
        displaySearchResults(data.results);
        hideLoader();
    } catch(err) {
        handleError(err);
    }
}

